@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid p-0">

    <div class="text-center text-white p-5"
         style="background: linear-gradient(120deg, #101d36, #087c91);">

        <h1 class="display-3 fw-bold">
            RACEDAY
        </h1>

        <h3>Every Race Has A Story</h3>

        <p class="lead mt-3">
            Discover events, challenge yourself
            and track your racing journey.
        </p>

        <a href="/Events/Index"
           class="btn btn-warning btn-lg mt-3">
            Explore Events
        </a>

    </div>

    <div class="container mt-5">

        <h2 class="text-center fw-bold mb-4">
            Welcome to RaceDay
        </h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow p-4 h-100">
                    <h4>Upcoming Events</h4>
                    <p>
                        Discover upcoming running events
                        and find your next challenge.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow p-4 h-100">
                    <h4>Join a Race</h4>
                    <p>
                        Register for events and choose
                        your preferred race category.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow p-4 h-100">
                    <h4>Track Results</h4>
                    <p>
                        View your race history and
                        monitor your performance.
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>