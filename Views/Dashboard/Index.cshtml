@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

    <h1>Welcome to RaceDay</h1>

    <p class="text-muted">
        Your RaceDay dashboard
    </p>

    <div class="alert alert-info">
        Logged in as: <strong>@ViewBag.Email</strong>
    </div>

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Explore Events</h4>
                    <p>Discover upcoming running events.</p>
                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>My Enrolments</h4>
                    <p>View the events you have joined.</p>
                    <a href="#" class="btn btn-primary">
                        My Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Race Results</h4>
                    <p>View race results and performance.</p>
                    <a href="#" class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>