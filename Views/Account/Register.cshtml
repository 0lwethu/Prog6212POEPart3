@model RaceDayMVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow p-4">
                <h2 class="text-center fw-bold">Join RaceDay</h2>
                <p class="text-center text-muted">
                    Create your RaceDay account
                </p>

                <form asp-action="Register" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Username"
                               class="form-label">Username</label>
                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Enter username" />
                        <span asp-validation-for="Username"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">Email</label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter email" />
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">Password</label>
                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Create password" />
                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoleId"
                               class="form-label">Account Type</label>

                        <select asp-for="RoleId"
                                class="form-select">
                            <option value="">Select account type</option>
                            <option value="1">Participant</option>
                            <option value="2">Organiser</option>
                        </select>

                        <span asp-validation-for="RoleId"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Create Account
                    </button>

                </form>

                <p class="text-center mt-3">
                    Already registered?
                    <a asp-action="Login">Login here</a>
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}