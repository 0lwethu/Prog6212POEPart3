@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <h1>Participant Dashboard</h1>
    <p>Welcome, @ViewBag.Email!</p>
    <p>Manage your RaceDay activities from here.</p>

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>My Profile</h4>
                    <p>View and manage your personal information.</p>
                    <a asp-action="Profile"
                       class="btn btn-primary">Open Profile</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>My Enrolments</h4>
                    <p>View the races you have joined.</p>
                    <a asp-action="Enrolments"
                       class="btn btn-primary">View Enrolments</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>My Results</h4>
                    <p>Check your race performance.</p>
                    <a asp-action="Results"
                       class="btn btn-primary">View Results</a>
                </div>
            </div>
        </div>

    </div>

    <a asp-controller="Events" asp-action="Index"
       class="btn btn-success mt-3">Explore Events</a>
</div>